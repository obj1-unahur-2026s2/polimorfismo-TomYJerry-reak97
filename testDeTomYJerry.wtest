import tomYJerry.*

describe "test del ejercicio de tom y jerry" {

    test "Al inicio, la velocidad máxima de Tom es 10" {
        assert.equals(10,tom.velocidadMaxima())
    }

    test "Al inicio, la energia de Tom es 50" {
        assert.equals(50,tom.energia())
    }

    test "si tom come a Jerry, la velocidad máxima pasa a ser 15.2" {
        tom.comer(jerry)
        assert.equals(15.2,tom.velocidadMaxima())
    }

    test "si tom come a jerry, su energia pasa a ser 102" {
        tom.comer(jerry)
        assert.equals(102,tom.energia())
    }

    test "si tom corre 24 metros, su velocidad maxima para a ser 14" {
        tom.comer(jerry)
        tom.correr(24)
        assert.equals(14,tom.velocidadMaxima())
    }
}